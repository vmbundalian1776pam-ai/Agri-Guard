{
  "name": "Agri-Guard Codespaces",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8000, 5000, 8081],
  "portsAttributes": {
    "8000": {
      "label": "PHP Backend Server",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "5000": {
      "label": "AI Flask Model Server",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "8081": {
      "label": "Expo Metro Bundler",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
